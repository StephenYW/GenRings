# mock: procedural offline images, no API key needed (default)
# openai: real image generation via OpenAI's gpt-image-1
IMAGE_PROVIDER=mock

# Required only when IMAGE_PROVIDER=openai. Get one at https://platform.openai.com/api-keys
# Note: gpt-image-1 requires your OpenAI organization to complete identity verification
# before it will generate images (Settings -> Organization -> General on platform.openai.com).
OPENAI_API_KEY=

# Optional overrides.
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_QUALITY=medium

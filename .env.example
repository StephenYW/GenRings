# mock: procedural offline images, no API key needed (default)
# openai: real image generation via OpenAI's gpt-image-2.5 (Flare/Sunburst)
IMAGE_PROVIDER=mock

# Required only when IMAGE_PROVIDER=openai. Get one at https://platform.openai.com/api-keys
# Note: OpenAI's image models require your organization to complete identity
# verification before they will generate images (Settings -> Organization ->
# General on platform.openai.com).
OPENAI_API_KEY=

# Optional overrides.
# Model: gpt-image-2.5-flare (default, cheaper/faster) or gpt-image-2.5-sunburst
# (premium, more detail). Do NOT use gpt-image-1 -- OpenAI is shutting it down
# Dec 1, 2026.
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
# Quality: low (cheapest) | medium | high | xhigh | max (most expensive) | auto
OPENAI_IMAGE_QUALITY=medium

# mock: procedural offline images, no API key needed (default)
# openai: real image generation via OpenAI's gpt-image-2.5 (Flare/Sunburst)
IMAGE_PROVIDER=mock

# Required only when IMAGE_PROVIDER=openai. Get one at https://platform.openai.com/api-keys
# Note: OpenAI's image models require your organization to complete identity
# verification before they will generate images (Settings -> Organization ->
# General on platform.openai.com).
OPENAI_API_KEY=

# Optional overrides.
# Model: gpt-image-2.5-flare (default, cheaper/faster) or gpt-image-2.5-sunburst
# (premium, more detail). Do NOT use gpt-image-1 -- OpenAI is shutting it down
# Dec 1, 2026.
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
# Quality: low (cheapest) | medium | high | xhigh | max (most expensive) | auto
OPENAI_IMAGE_QUALITY=medium

# AI relief generation ("Design with AI" panel). fal.ai is preferred: get a key at
# https://fal.ai/dashboard/keys . Defaults: FLUX.1 Kontext [pro] (~$0.04/image) for
# single images, Kontext [dev] (~$0.025/image) for the 4-variation requests. Other
# options: fal-ai/qwen-image-edit, fal-ai/qwen-image-edit-plus, fal-ai/flux-2/edit,
# fal-ai/flux-2-pro/edit.
FAL_KEY=
FAL_MODEL=fal-ai/flux-pro/kontext
FAL_MODEL_VARIATIONS=fal-ai/flux-kontext/dev

# Alternative: Stable Diffusion via Stability AI (used only when FAL_KEY is empty).
# Get a key at https://platform.stability.ai/account/keys . Without one, the panel
# uses a free offline stand-in so the flow still works.
STABILITY_API_KEY=
# Structure Control costs this many credits per image (1 credit = $0.01); used for
# the usage counter. Check https://platform.stability.ai/pricing if it changes.
STABILITY_CREDITS_PER_IMAGE=5
